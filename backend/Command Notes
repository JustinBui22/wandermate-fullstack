// WanderMate backend command reference.
// Run commands from backend/ unless the note says otherwise.
-------------------------------------------------------------------------

// Maven wrapper (recommended because Maven does not need to be installed globally)
// macOS/Linux
./mvnw spring-boot:run
./mvnw test
./mvnw clean package
./mvnw clean package -DskipTests
./mvnw test -Dtest=TokenServiceImplTest

// Windows PowerShell / Command Prompt
.\mvnw.cmd spring-boot:run
.\mvnw.cmd test
.\mvnw.cmd clean package

// Direct IntelliJ/Maven runs do not automatically read backend/.env.
// Configure DB_URL, DB_USERNAME, DB_PASSWORD, JWT_SECRET and
// REFRESH_TOKEN_HASH_SECRET in the process environment.

// Docker Compose automatically reads backend/.env.
docker compose up
docker compose up --build
docker compose up -d --build
docker compose ps
docker compose logs -f backend
docker compose logs -f db
docker compose down

// WARNING: deletes the local MariaDB named volume and all its data.
docker compose down -v

// Start only the DB for an IntelliJ backend run.
docker compose up -d db

// Host DB URL when the database container exposes port 3307.
// DB_URL=jdbc:mariadb://localhost:3307/traveling_app

// Container-to-container DB URL used by docker-compose.yml.
// DB_URL=jdbc:mariadb://db:3306/traveling_app

// Health checks
curl http://localhost:8080/Wandermate/api/v1/health
curl http://localhost:8082/Wandermate/api/v1/health

// Git checks from repository root
git status --short
git diff --check
git show --name-only --stat HEAD

git ls-files | Select-String -Pattern "(^|/)\.env$|(^|/)target/|(^|/)node_modules/|(^|/)\.idea/|full-init\.sql$"

// Create a clean archive from committed files instead of zipping the working tree.
git archive --format=zip --output=wandermate-source.zip HEAD
